[TEMPLATE]
# Copy this file to ".env" and fill in your keys.

# Primary cloud gateway (ZenMux) — every "<id>" cloud request without a
# gateway prefix routes through here. Get a key at https://zenmux.ai
# (one key unlocks every cloud model below).
ZENMUX_API_KEY=sk-your-key-here

# Freebuff extra gateway — works ALONGSIDE ZenMux. "<name>/<model>" requests
# route through Freebuff instead of ZenMux. Get a key at https://freebuff.com.
FREEBUFF_API_KEY=

# Colibri (GLM 5.2) local_provider on your second desktop — 12-factor driven.
#   COLIBRI_BASE_URL  e.g. http://192.168.1.42:8000/v1
#   COLIBRI_API_KEY   blank OK if your Colibri doesn't require auth.
COLIBRI_BASE_URL=
COLIBRI_API_KEY=
